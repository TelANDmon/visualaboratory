{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "strict": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"]
  },
  "include": ["*.ts", "visualaboratory/lab3.test.ts"],
  "exclude": ["node_modules"]
}